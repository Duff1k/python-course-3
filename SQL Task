--Запросы
--Вывести список всех студентов с названием факультета, на котором они учатся.
(подсказка: JOIN Student s ON s.faculty_id = f.id)

SELECT full_name, faculty.name
FROM faculty
JOIN student ON faculty_id = faculty.id

--Вывести список курсов с указанием факультета, к которому они относятся.

SELECT course.name, faculty.name
FROM course
JOIN faculty ON faculty_id = faculty.id

--Вывести список студентов и курсов, на которые они зачислены.

SELECT full_name, course.name
FROM enrollment
JOIN student ON student_id = student.id
JOIN course ON course_id = course.id

--Найти всех студентов, которые учатся более чем на одном курсе.

SELECT full_name
FROM student
JOIN enrollment ON student.id = student_id
GROUP BY full_name
HAVING COUNT(course_id) > 1

--Найти курсы, на которых учатся более 2 студентов.

SELECT course.name
FROM course
JOIN enrollment ON course.id = enrollment.course_id
GROUP BY course.name
HAVING COUNT(student_id) > 2